{
  "expo": {
    "name": "Al Día",
    "slug": "al-dia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "aldia",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aldia.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Al Día usa Face ID para proteger tus datos."
      }
    },
    "android": {
      "package": "com.aldia.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E5E63",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Al Día usa Face ID para proteger tus datos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0E5E63",
          "defaultChannel": "vencimientos"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E5E63",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Upcoming",
              "label": "Al Día · Próximos pagos",
              "description": "Tus próximos vencimientos y el total pendiente del mes",
              "minWidth": "250dp",
              "minHeight": "150dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "15637e9b-10dd-4294-aa3c-3575f9a641ec"
      }
    },
    "owner": "hiroforyou"
  }
}
